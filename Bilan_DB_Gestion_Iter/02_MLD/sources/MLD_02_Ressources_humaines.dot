digraph G {
 graph [rankdir=LR, fontname="DejaVu Sans", fontsize=18, labelloc=t, label=<<B>MLD 02 — Ressources humaines</B>>, pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, ];
 node  [fontname="DejaVu Sans", fontsize=10, shape=plaintext];
 edge  [fontname="DejaVu Sans", fontsize=9, arrowsize=0.7];
  "personnes" [label=<<TABLE BORDER="1" COLOR="#3F7D2E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#E3F2DD"><TR><TD COLSPAN="2" BGCOLOR="#3F7D2E"><FONT COLOR="white"><B>personnes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="nom">nom</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="prenoms">prenoms</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="sexe">sexe</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="date_naissance">date_naissance</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="lieu_naissance">lieu_naissance</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="nationalite">nationalite</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="telephone">telephone</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="adresse">adresse</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="photo">photo</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD></TD></TR></TABLE>>];
  "etudiants" [label=<<TABLE BORDER="1" COLOR="#3F7D2E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#E3F2DD"><TR><TD COLSPAN="2" BGCOLOR="#3F7D2E"><FONT COLOR="white"><B>etudiants</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="personne_id"><I>#personne_id</I></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="matricule">matricule</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="date_premiere_inscription">date_premiere_inscription</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="statut">statut</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="observations">observations</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="promotion_id"><I>#promotion_id</I></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD></TD></TR></TABLE>>];
  "professeurs" [label=<<TABLE BORDER="1" COLOR="#3F7D2E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#E3F2DD"><TR><TD COLSPAN="2" BGCOLOR="#3F7D2E"><FONT COLOR="white"><B>professeurs</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="personne_id"><I>#personne_id</I></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="matricule">matricule</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="grade">grade</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="specialite">specialite</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="date_recrutement">date_recrutement</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="statut">statut</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="observations">observations</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD></TD></TR></TABLE>>];
  "administrateurs" [label=<<TABLE BORDER="1" COLOR="#3F7D2E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#E3F2DD"><TR><TD COLSPAN="2" BGCOLOR="#3F7D2E"><FONT COLOR="white"><B>administrateurs</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="personne_id"><I>#personne_id</I></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="matricule">matricule</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="fonction">fonction</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="statut">statut</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD></TD></TR></TABLE>>];
  "users" [label=<<TABLE BORDER="1" COLOR="#3F7D2E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#E3F2DD"><TR><TD COLSPAN="2" BGCOLOR="#3F7D2E"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="password">password</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="administrateur_id"><I>#administrateur_id</I></TD><TD></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I><FONT COLOR="#666666">… colonnes à compléter</FONT></I></TD></TR></TABLE>>];
  "promotions" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", label=<<B>promotions</B>>];
  "etudiants":"personne_id" -> "personnes":id [style=solid, color="#555555"];
  "etudiants":"promotion_id" -> "promotions" [style=dashed, color="#555555"];
  "professeurs":"personne_id" -> "personnes":id [style=solid, color="#555555"];
  "administrateurs":"personne_id" -> "personnes":id [style=solid, color="#555555"];
  "users":"administrateur_id" -> "administrateurs":id [style=solid, color="#555555"];
}

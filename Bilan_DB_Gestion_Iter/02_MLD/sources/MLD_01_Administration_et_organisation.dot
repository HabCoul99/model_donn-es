digraph G {
 graph [rankdir=LR, fontname="DejaVu Sans", fontsize=18, labelloc=t, label=<<B>MLD 01 — Administration et organisation</B>>, pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, ];
 node  [fontname="DejaVu Sans", fontsize=10, shape=plaintext];
 edge  [fontname="DejaVu Sans", fontsize=9, arrowsize=0.7];
  "types_structures" [label=<<TABLE BORDER="1" COLOR="#2F5D8C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#DCE9F7"><TR><TD COLSPAN="2" BGCOLOR="#2F5D8C"><FONT COLOR="white"><B>types_structures</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="code">code</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="libelle">libelle</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="actif">actif</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD></TD></TR></TABLE>>];
  "structures" [label=<<TABLE BORDER="1" COLOR="#2F5D8C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#DCE9F7"><TR><TD COLSPAN="2" BGCOLOR="#2F5D8C"><FONT COLOR="white"><B>structures</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="type_structure_id"><I>#type_structure_id</I></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="parent_id"><I>#parent_id</I></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="code">code</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="nom">nom</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="actif">actif</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="archivee">archivee</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD></TD></TR></TABLE>>];
  "departements" [label=<<TABLE BORDER="1" COLOR="#2F5D8C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#DCE9F7"><TR><TD COLSPAN="2" BGCOLOR="#2F5D8C"><FONT COLOR="white"><B>departements</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="structure_id"><I>#structure_id</I></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="code">code</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="nom">nom</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="est_actif">est_actif</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD></TD></TR></TABLE>>];
  "postes" [label=<<TABLE BORDER="1" COLOR="#2F5D8C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#DCE9F7"><TR><TD COLSPAN="2" BGCOLOR="#2F5D8C"><FONT COLOR="white"><B>postes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="code">code</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="libelle">libelle</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="actif">actif</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD></TD></TR></TABLE>>];
  "postes_structures" [label=<<TABLE BORDER="1" COLOR="#2F5D8C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#DCE9F7"><TR><TD COLSPAN="2" BGCOLOR="#2F5D8C"><FONT COLOR="white"><B>postes_structures</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="structure_id"><I>#structure_id</I></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="poste_id"><I>#poste_id</I></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="actif">actif</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD></TD></TR></TABLE>>];
  "affectations_postes" [label=<<TABLE BORDER="1" COLOR="#2F5D8C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#DCE9F7"><TR><TD COLSPAN="2" BGCOLOR="#2F5D8C"><FONT COLOR="white"><B>affectations_postes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="poste_structure_id"><I>#poste_structure_id</I></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="personne_id"><I>#personne_id</I></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="date_debut">date_debut</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="date_fin">date_fin</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="motif">motif</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD></TD></TR></TABLE>>];
  "personnes" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", label=<<B>personnes</B>>];
  "structures":"type_structure_id" -> "types_structures":id [style=solid, color="#555555"];
  "structures":"parent_id" -> "structures":id [style=dashed, color="#555555"];
  "departements":"structure_id" -> "structures":id [style=solid, color="#555555"];
  "postes_structures":"structure_id" -> "structures":id [style=solid, color="#555555"];
  "postes_structures":"poste_id" -> "postes":id [style=solid, color="#555555"];
  "affectations_postes":"poste_structure_id" -> "postes_structures":id [style=solid, color="#555555"];
  "affectations_postes":"personne_id" -> "personnes" [style=solid, color="#555555"];
}

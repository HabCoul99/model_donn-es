digraph G {
 graph [rankdir=LR, fontname="DejaVu Sans", fontsize=18, labelloc=t, label=<<B>MPD 07 — Planification (types proposés)</B>>, pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, ];
 node  [fontname="DejaVu Sans", fontsize=10, shape=plaintext];
 edge  [fontname="DejaVu Sans", fontsize=9, arrowsize=0.7];
  "affectations_pedagogiques" [label=<<TABLE BORDER="1" COLOR="#B03A66" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FFE9F0"><TR><TD COLSPAN="2" BGCOLOR="#B03A66"><FONT COLOR="white"><B>affectations_pedagogiques</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="promotion_classe_id"><I>#promotion_classe_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ecue_id"><I>#ecue_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="professeur_id"><I>#professeur_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="date_debut">date_debut</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATE NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="date_fin">date_fin</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATE NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="statut">statut</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(255) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="observations">observations</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TEXT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR></TABLE>>];
  "emplois_du_temps" [label=<<TABLE BORDER="1" COLOR="#B03A66" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FFE9F0"><TR><TD COLSPAN="2" BGCOLOR="#B03A66"><FONT COLOR="white"><B>emplois_du_temps</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="promotion_classe_id"><I>#promotion_classe_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="semestre_id"><I>#semestre_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="date_debut">date_debut</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATE NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="date_fin">date_fin</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATE NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="statut">statut</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(255) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TEXT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR></TABLE>>];
  "cours_plannifies" [label=<<TABLE BORDER="1" COLOR="#B03A66" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FFE9F0"><TR><TD COLSPAN="2" BGCOLOR="#B03A66"><FONT COLOR="white"><B>cours_plannifies</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="emploi_du_temps_id"><I>#emploi_du_temps_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ecue_id"><I>#ecue_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="professeur_id"><I>#professeur_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="salle_id"><I>#salle_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="affectation_pedagogique_id"><I>#affectation_pedagogique_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="jour_semaine">jour_semaine</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(255) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creneau">creneau</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(255) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="date_debut">date_debut</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATE NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="date_fin">date_fin</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATE NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="statut">statut</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(255) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="observations">observations</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TEXT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR></TABLE>>];
  "historique_cours_plannifies" [label=<<TABLE BORDER="1" COLOR="#B03A66" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FFE9F0"><TR><TD COLSPAN="2" BGCOLOR="#B03A66"><FONT COLOR="white"><B>historique_cours_plannifies</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cours_plannifie_id"><I>#cours_plannifie_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NULL</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I><FONT COLOR="#666666">… colonnes à compléter</FONT></I></TD></TR></TABLE>>];
  "salles" [label=<<TABLE BORDER="1" COLOR="#B03A66" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FFE9F0"><TR><TD COLSPAN="2" BGCOLOR="#B03A66"><FONT COLOR="white"><B>salles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(255) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nom">nom</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(255) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="type">type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(255) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="capacite">capacite</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="localisation">localisation</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(255) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="statut">statut</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(255) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TEXT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR></TABLE>>];
  "evenements" [label=<<TABLE BORDER="1" COLOR="#B03A66" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FFE9F0"><TR><TD COLSPAN="2" BGCOLOR="#B03A66"><FONT COLOR="white"><B>evenements</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I><FONT COLOR="#666666">… colonnes à compléter</FONT></I></TD></TR></TABLE>>];
  "ecues" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", label=<<B>ecues</B>>];
  "professeurs" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", label=<<B>professeurs</B>>];
  "promotions_classes" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", label=<<B>promotions_classes</B>>];
  "semestres" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", label=<<B>semestres</B>>];
  "affectations_pedagogiques":"promotion_classe_id" -> "promotions_classes" [style=solid, color="#555555"];
  "affectations_pedagogiques":"ecue_id" -> "ecues" [style=solid, color="#555555"];
  "affectations_pedagogiques":"professeur_id" -> "professeurs" [style=solid, color="#555555"];
  "emplois_du_temps":"promotion_classe_id" -> "promotions_classes" [style=solid, color="#555555"];
  "emplois_du_temps":"semestre_id" -> "semestres" [style=solid, color="#555555"];
  "cours_plannifies":"emploi_du_temps_id" -> "emplois_du_temps":id [style=solid, color="#555555"];
  "cours_plannifies":"ecue_id" -> "ecues" [style=solid, color="#555555"];
  "cours_plannifies":"professeur_id" -> "professeurs" [style=solid, color="#555555"];
  "cours_plannifies":"salle_id" -> "salles":id [style=solid, color="#555555"];
  "cours_plannifies":"affectation_pedagogique_id" -> "affectations_pedagogiques":id [style=dashed, color="#555555"];
  "historique_cours_plannifies":"cours_plannifie_id" -> "cours_plannifies":id [style=dashed, color="#555555"];
}

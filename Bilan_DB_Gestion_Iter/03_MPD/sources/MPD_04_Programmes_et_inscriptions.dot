digraph G {
 graph [rankdir=LR, fontname="DejaVu Sans", fontsize=18, labelloc=t, label=<<B>MPD 04 — Programmes et inscriptions (types proposés)</B>>, pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, ];
 node  [fontname="DejaVu Sans", fontsize=10, shape=plaintext];
 edge  [fontname="DejaVu Sans", fontsize=9, arrowsize=0.7];
  "programmes" [label=<<TABLE BORDER="1" COLOR="#6B3F86" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#EBDDF3"><TR><TD COLSPAN="2" BGCOLOR="#6B3F86"><FONT COLOR="white"><B>programmes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="departement_id"><I>#departement_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(255) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nom">nom</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(255) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TEXT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="est_actif">est_actif</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TINYINT(1) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR></TABLE>>];
  "versions_programmes_pedagogiques" [label=<<TABLE BORDER="1" COLOR="#6B3F86" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#EBDDF3"><TR><TD COLSPAN="2" BGCOLOR="#6B3F86"><FONT COLOR="white"><B>versions_programmes_pedagogiques</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="programme_id"><I>#programme_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="annee_universitaire_id"><I>#annee_universitaire_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(255) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="libelle">libelle</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(255) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="version">version</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(255) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="date_debut">date_debut</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATE NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="date_fin">date_fin</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">DATE NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="statut">statut</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(255) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR></TABLE>>];
  "version_programme_unites" [label=<<TABLE BORDER="1" COLOR="#6B3F86" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#EBDDF3"><TR><TD COLSPAN="2" BGCOLOR="#6B3F86"><FONT COLOR="white"><B>version_programme_unites</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="version_programme_id"><I>#version_programme_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unite_enseignement_id"><I>#unite_enseignement_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I><FONT COLOR="#666666">… colonnes à compléter</FONT></I></TD></TR></TABLE>>];
  "inscriptions_academiques" [label=<<TABLE BORDER="1" COLOR="#6B3F86" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#EBDDF3"><TR><TD COLSPAN="2" BGCOLOR="#6B3F86"><FONT COLOR="white"><B>inscriptions_academiques</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="etudiant_id"><I>#etudiant_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="annee_universitaire_id"><I>#annee_universitaire_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="niveau_etude_id"><I>#niveau_etude_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="classe_id"><I>#classe_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="version_programme_id"><I>#version_programme_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I><FONT COLOR="#666666">… colonnes à compléter</FONT></I></TD></TR></TABLE>>];
  "regles_pedagogiques" [label=<<TABLE BORDER="1" COLOR="#6B3F86" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#EBDDF3"><TR><TD COLSPAN="2" BGCOLOR="#6B3F86"><FONT COLOR="white"><B>regles_pedagogiques</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="programme_id"><I>#programme_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="version_programme_id"><I>#version_programme_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NULL</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I><FONT COLOR="#666666">… colonnes à compléter</FONT></I></TD></TR></TABLE>>];
  "annees_universitaires" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", label=<<B>annees_universitaires</B>>];
  "classes" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", label=<<B>classes</B>>];
  "departements" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", label=<<B>departements</B>>];
  "etudiants" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", label=<<B>etudiants</B>>];
  "niveaux_etude" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", label=<<B>niveaux_etude</B>>];
  "unites_enseignement" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", label=<<B>unites_enseignement</B>>];
  "programmes":"departement_id" -> "departements" [style=solid, color="#555555"];
  "versions_programmes_pedagogiques":"programme_id" -> "programmes":id [style=solid, color="#555555"];
  "versions_programmes_pedagogiques":"annee_universitaire_id" -> "annees_universitaires" [style=solid, color="#555555"];
  "version_programme_unites":"version_programme_id" -> "versions_programmes_pedagogiques":id [style=solid, color="#555555"];
  "version_programme_unites":"unite_enseignement_id" -> "unites_enseignement" [style=solid, color="#555555"];
  "inscriptions_academiques":"etudiant_id" -> "etudiants" [style=solid, color="#555555"];
  "inscriptions_academiques":"annee_universitaire_id" -> "annees_universitaires" [style=solid, color="#555555"];
  "inscriptions_academiques":"niveau_etude_id" -> "niveaux_etude" [style=solid, color="#555555"];
  "inscriptions_academiques":"classe_id" -> "classes" [style=solid, color="#555555"];
  "inscriptions_academiques":"version_programme_id" -> "versions_programmes_pedagogiques":id [style=solid, color="#555555"];
  "regles_pedagogiques":"programme_id" -> "programmes":id [style=dashed, color="#555555"];
  "regles_pedagogiques":"version_programme_id" -> "versions_programmes_pedagogiques":id [style=dashed, color="#555555"];
}

digraph G {
 graph [rankdir=LR, fontname="DejaVu Sans", fontsize=18, labelloc=t, label=<<B>MPD 03 — Structure pédagogique (types proposés)</B>>, pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, ];
 node  [fontname="DejaVu Sans", fontsize=10, shape=plaintext];
 edge  [fontname="DejaVu Sans", fontsize=9, arrowsize=0.7];
  "filieres" [label=<<TABLE BORDER="1" COLOR="#B07A12" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FFF1D6"><TR><TD COLSPAN="2" BGCOLOR="#B07A12"><FONT COLOR="white"><B>filieres</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="departement_id"><I>#departement_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(255) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nom">nom</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(255) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TEXT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="actif">actif</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TINYINT(1) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR></TABLE>>];
  "departement_filiere" [label=<<TABLE BORDER="1" COLOR="#B07A12" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FFF1D6"><TR><TD COLSPAN="2" BGCOLOR="#B07A12"><FONT COLOR="white"><B>departement_filiere</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="departement_id"><B><U>#departement_id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="filiere_id"><B><U>#filiere_id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR></TABLE>>];
  "classes" [label=<<TABLE BORDER="1" COLOR="#B07A12" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FFF1D6"><TR><TD COLSPAN="2" BGCOLOR="#B07A12"><FONT COLOR="white"><B>classes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="niveau_etude_id"><I>#niveau_etude_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(255) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nom">nom</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(255) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TEXT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="capacite">capacite</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">INT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="actif">actif</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TINYINT(1) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR></TABLE>>];
  "classe_filiere" [label=<<TABLE BORDER="1" COLOR="#B07A12" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FFF1D6"><TR><TD COLSPAN="2" BGCOLOR="#B07A12"><FONT COLOR="white"><B>classe_filiere</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="classe_id"><B><U>#classe_id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="filiere_id"><B><U>#filiere_id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR></TABLE>>];
  "niveaux_etude" [label=<<TABLE BORDER="1" COLOR="#B07A12" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FFF1D6"><TR><TD COLSPAN="2" BGCOLOR="#B07A12"><FONT COLOR="white"><B>niveaux_etude</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I><FONT COLOR="#666666">… colonnes à compléter</FONT></I></TD></TR></TABLE>>];
  "annees_universitaires" [label=<<TABLE BORDER="1" COLOR="#B07A12" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FFF1D6"><TR><TD COLSPAN="2" BGCOLOR="#B07A12"><FONT COLOR="white"><B>annees_universitaires</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I><FONT COLOR="#666666">… colonnes à compléter</FONT></I></TD></TR></TABLE>>];
  "promotions" [label=<<TABLE BORDER="1" COLOR="#B07A12" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FFF1D6"><TR><TD COLSPAN="2" BGCOLOR="#B07A12"><FONT COLOR="white"><B>promotions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I><FONT COLOR="#666666">… colonnes à compléter</FONT></I></TD></TR></TABLE>>];
  "promotions_classes" [label=<<TABLE BORDER="1" COLOR="#B07A12" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FFF1D6"><TR><TD COLSPAN="2" BGCOLOR="#B07A12"><FONT COLOR="white"><B>promotions_classes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="classe_id"><I>#classe_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="annee_universitaire_id"><I>#annee_universitaire_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="programme_id"><I>#programme_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="actif">actif</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TINYINT(1) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="observations">observations</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TEXT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR></TABLE>>];
  "departements" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", label=<<B>departements</B>>];
  "programmes" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", label=<<B>programmes</B>>];
  "filieres":"departement_id" -> "departements" [style=dashed, color="#555555"];
  "departement_filiere":"departement_id" -> "departements" [style=solid, color="#555555"];
  "departement_filiere":"filiere_id" -> "filieres":id [style=solid, color="#555555"];
  "classes":"niveau_etude_id" -> "niveaux_etude":id [style=solid, color="#555555"];
  "classe_filiere":"classe_id" -> "classes":id [style=solid, color="#555555"];
  "classe_filiere":"filiere_id" -> "filieres":id [style=solid, color="#555555"];
  "promotions_classes":"classe_id" -> "classes":id [style=solid, color="#555555"];
  "promotions_classes":"annee_universitaire_id" -> "annees_universitaires":id [style=solid, color="#555555"];
  "promotions_classes":"programme_id" -> "programmes" [style=dashed, color="#555555"];
}

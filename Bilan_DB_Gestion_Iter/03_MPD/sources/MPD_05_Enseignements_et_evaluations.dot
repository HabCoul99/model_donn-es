digraph G {
 graph [rankdir=LR, fontname="DejaVu Sans", fontsize=18, labelloc=t, label=<<B>MPD 05 — Enseignements et évaluations (types proposés)</B>>, pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, ];
 node  [fontname="DejaVu Sans", fontsize=10, shape=plaintext];
 edge  [fontname="DejaVu Sans", fontsize=9, arrowsize=0.7];
  "semestres" [label=<<TABLE BORDER="1" COLOR="#B3492F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FCE0D9"><TR><TD COLSPAN="2" BGCOLOR="#B3492F"><FONT COLOR="white"><B>semestres</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="niveau_etude_id"><I>#niveau_etude_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I><FONT COLOR="#666666">… colonnes à compléter</FONT></I></TD></TR></TABLE>>];
  "unites_enseignement" [label=<<TABLE BORDER="1" COLOR="#B3492F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FCE0D9"><TR><TD COLSPAN="2" BGCOLOR="#B3492F"><FONT COLOR="white"><B>unites_enseignement</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="semestre_id"><I>#semestre_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I><FONT COLOR="#666666">… colonnes à compléter</FONT></I></TD></TR></TABLE>>];
  "ecues" [label=<<TABLE BORDER="1" COLOR="#B3492F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FCE0D9"><TR><TD COLSPAN="2" BGCOLOR="#B3492F"><FONT COLOR="white"><B>ecues</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unite_enseignement_id"><I>#unite_enseignement_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NULL</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I><FONT COLOR="#666666">… colonnes à compléter</FONT></I></TD></TR></TABLE>>];
  "promotion_classe_unites" [label=<<TABLE BORDER="1" COLOR="#B3492F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FCE0D9"><TR><TD COLSPAN="2" BGCOLOR="#B3492F"><FONT COLOR="white"><B>promotion_classe_unites</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="promotion_classe_id"><I>#promotion_classe_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unite_enseignement_id"><I>#unite_enseignement_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="obligatoire">obligatoire</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TINYINT(1) NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="observations">observations</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TEXT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP NULL</FONT></TD></TR></TABLE>>];
  "evaluations" [label=<<TABLE BORDER="1" COLOR="#B3492F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FCE0D9"><TR><TD COLSPAN="2" BGCOLOR="#B3492F"><FONT COLOR="white"><B>evaluations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ecue_id"><I>#ecue_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="annee_universitaire_id"><I>#annee_universitaire_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I><FONT COLOR="#666666">… colonnes à compléter</FONT></I></TD></TR></TABLE>>];
  "notes" [label=<<TABLE BORDER="1" COLOR="#B3492F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FCE0D9"><TR><TD COLSPAN="2" BGCOLOR="#B3492F"><FONT COLOR="white"><B>notes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="evaluation_id"><I>#evaluation_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="inscription_academique_id"><I>#inscription_academique_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="saisie_par"><I>#saisie_par</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NULL</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I><FONT COLOR="#666666">… colonnes à compléter</FONT></I></TD></TR></TABLE>>];
  "sessions_rattrapage" [label=<<TABLE BORDER="1" COLOR="#B3492F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FCE0D9"><TR><TD COLSPAN="2" BGCOLOR="#B3492F"><FONT COLOR="white"><B>sessions_rattrapage</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="annee_universitaire_id"><I>#annee_universitaire_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I><FONT COLOR="#666666">… colonnes à compléter</FONT></I></TD></TR></TABLE>>];
  "notes_rattrapage" [label=<<TABLE BORDER="1" COLOR="#B3492F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FCE0D9"><TR><TD COLSPAN="2" BGCOLOR="#B3492F"><FONT COLOR="white"><B>notes_rattrapage</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED AUTO_INCREMENT NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="session_rattrapage_id"><I>#session_rattrapage_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ecue_id"><I>#ecue_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="inscription_academique_id"><I>#inscription_academique_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="saisie_par"><I>#saisie_par</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">BIGINT UNSIGNED NULL</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I><FONT COLOR="#666666">… colonnes à compléter</FONT></I></TD></TR></TABLE>>];
  "administrateurs" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", label=<<B>administrateurs</B>>];
  "annees_universitaires" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", label=<<B>annees_universitaires</B>>];
  "inscriptions_academiques" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", label=<<B>inscriptions_academiques</B>>];
  "niveaux_etude" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", label=<<B>niveaux_etude</B>>];
  "promotions_classes" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", label=<<B>promotions_classes</B>>];
  "semestres":"niveau_etude_id" -> "niveaux_etude" [style=solid, color="#555555"];
  "unites_enseignement":"semestre_id" -> "semestres":id [style=solid, color="#555555"];
  "ecues":"unite_enseignement_id" -> "unites_enseignement":id [style=dashed, color="#555555"];
  "promotion_classe_unites":"promotion_classe_id" -> "promotions_classes" [style=solid, color="#555555"];
  "promotion_classe_unites":"unite_enseignement_id" -> "unites_enseignement":id [style=solid, color="#555555"];
  "evaluations":"ecue_id" -> "ecues":id [style=solid, color="#555555"];
  "evaluations":"annee_universitaire_id" -> "annees_universitaires" [style=solid, color="#555555"];
  "notes":"evaluation_id" -> "evaluations":id [style=solid, color="#555555"];
  "notes":"inscription_academique_id" -> "inscriptions_academiques" [style=solid, color="#555555"];
  "notes":"saisie_par" -> "administrateurs" [style=dashed, color="#555555"];
  "sessions_rattrapage":"annee_universitaire_id" -> "annees_universitaires" [style=solid, color="#555555"];
  "notes_rattrapage":"session_rattrapage_id" -> "sessions_rattrapage":id [style=solid, color="#555555"];
  "notes_rattrapage":"ecue_id" -> "ecues":id [style=solid, color="#555555"];
  "notes_rattrapage":"inscription_academique_id" -> "inscriptions_academiques" [style=solid, color="#555555"];
  "notes_rattrapage":"saisie_par" -> "administrateurs" [style=dashed, color="#555555"];
}

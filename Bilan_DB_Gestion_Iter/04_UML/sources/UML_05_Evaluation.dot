digraph G {
 graph [rankdir=TB, fontname="DejaVu Sans", fontsize=18, labelloc=t, label=<<B>Diagramme de classes — Évaluation</B>>, pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, ];
 node  [fontname="DejaVu Sans", fontsize=10, shape=plaintext];
 edge  [fontname="DejaVu Sans", fontsize=9, arrowsize=0.7];
  "evaluations" [label=<<TABLE BORDER="1" COLOR="#B3492F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FCE0D9"><TR><TD BGCOLOR="#B3492F"><FONT COLOR="white"><B>Evaluation</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ ecue() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ anneeUniversitaire() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ notes() : HasMany</FONT></TD></TR></TABLE>>];
  "notes" [label=<<TABLE BORDER="1" COLOR="#B3492F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FCE0D9"><TR><TD BGCOLOR="#B3492F"><FONT COLOR="white"><B>Note</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ evaluation() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ inscriptionAcademique() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ saisiePar() : BelongsTo</FONT></TD></TR></TABLE>>];
  "sessions_rattrapage" [label=<<TABLE BORDER="1" COLOR="#B3492F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FCE0D9"><TR><TD BGCOLOR="#B3492F"><FONT COLOR="white"><B>SessionRattrapage</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ anneeUniversitaire() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ notesRattrapage() : HasMany</FONT></TD></TR></TABLE>>];
  "notes_rattrapage" [label=<<TABLE BORDER="1" COLOR="#B3492F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FCE0D9"><TR><TD BGCOLOR="#B3492F"><FONT COLOR="white"><B>NoteRattrapage</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ sessionRattrapage() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ ecue() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ inscriptionAcademique() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ saisiePar() : BelongsTo</FONT></TD></TR></TABLE>>];
  "resultats_ecues" [label=<<TABLE BORDER="1" COLOR="#1F7F76" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#D9F0EE"><TR><TD BGCOLOR="#1F7F76"><FONT COLOR="white"><B>ResultatEcue</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ inscriptionAcademique() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ ecue() : BelongsTo</FONT></TD></TR></TABLE>>];
  "resultats_unites" [label=<<TABLE BORDER="1" COLOR="#1F7F76" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#D9F0EE"><TR><TD BGCOLOR="#1F7F76"><FONT COLOR="white"><B>ResultatUnite</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ inscriptionAcademique() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ uniteEnseignement() : BelongsTo</FONT></TD></TR></TABLE>>];
  "resultats_semestres" [label=<<TABLE BORDER="1" COLOR="#1F7F76" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#D9F0EE"><TR><TD BGCOLOR="#1F7F76"><FONT COLOR="white"><B>ResultatSemestre</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ inscriptionAcademique() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ semestre() : BelongsTo</FONT></TD></TR></TABLE>>];
  "administrateurs" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>Administrateur</B>>];
  "annees_universitaires" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>AnneeUniversitaire</B>>];
  "ecues" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>Ecue</B>>];
  "inscriptions_academiques" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>InscriptionAcademique</B>>];
  "semestres" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>Semestre</B>>];
  "unites_enseignement" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>UniteEnseignement</B>>];
  "ecues" -> "evaluations" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "annees_universitaires" -> "evaluations" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "evaluations" -> "notes" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "inscriptions_academiques" -> "notes" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "administrateurs" -> "notes" [dir=none, taillabel="0..1", headlabel="0..*", labeldistance=1.8, fontsize=9, label="saisiePar"];
  "annees_universitaires" -> "sessions_rattrapage" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "sessions_rattrapage" -> "notes_rattrapage" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "ecues" -> "notes_rattrapage" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "inscriptions_academiques" -> "notes_rattrapage" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "administrateurs" -> "notes_rattrapage" [dir=none, taillabel="0..1", headlabel="0..*", labeldistance=1.8, fontsize=9, label="saisiePar"];
  "inscriptions_academiques" -> "resultats_ecues" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "ecues" -> "resultats_ecues" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "inscriptions_academiques" -> "resultats_unites" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "unites_enseignement" -> "resultats_unites" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "inscriptions_academiques" -> "resultats_semestres" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "semestres" -> "resultats_semestres" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
}

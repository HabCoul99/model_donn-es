digraph G {
 graph [rankdir=TB, fontname="DejaVu Sans", fontsize=18, labelloc=t, label=<<B>Diagramme de classes — Structure pédagogique</B>>, pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, ];
 node  [fontname="DejaVu Sans", fontsize=10, shape=plaintext];
 edge  [fontname="DejaVu Sans", fontsize=9, arrowsize=0.7];
  "filieres" [label=<<TABLE BORDER="1" COLOR="#B07A12" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF1D6"><TR><TD BGCOLOR="#B07A12"><FONT COLOR="white"><B>Filiere</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ code : string</TD></TR><TR><TD ALIGN="LEFT">+ nom : string</TD></TR><TR><TD ALIGN="LEFT">+ description : string</TD></TR><TR><TD ALIGN="LEFT">+ actif : bool</TD></TR><TR><TD ALIGN="LEFT">+ created_at : datetime</TD></TR><TR><TD ALIGN="LEFT">+ updated_at : datetime</TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ departement() : BelongsTo</FONT></TD></TR></TABLE>>];
  "classes" [label=<<TABLE BORDER="1" COLOR="#B07A12" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF1D6"><TR><TD BGCOLOR="#B07A12"><FONT COLOR="white"><B>Classe</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ code : string</TD></TR><TR><TD ALIGN="LEFT">+ nom : string</TD></TR><TR><TD ALIGN="LEFT">+ description : string</TD></TR><TR><TD ALIGN="LEFT">+ capacite : int</TD></TR><TR><TD ALIGN="LEFT">+ actif : bool</TD></TR><TR><TD ALIGN="LEFT">+ created_at : datetime</TD></TR><TR><TD ALIGN="LEFT">+ updated_at : datetime</TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ niveauEtude() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ promotionsClasses() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ inscriptionsAcademiques() : HasMany</FONT></TD></TR></TABLE>>];
  "niveaux_etude" [label=<<TABLE BORDER="1" COLOR="#B07A12" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF1D6"><TR><TD BGCOLOR="#B07A12"><FONT COLOR="white"><B>NiveauEtude</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ classes() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ inscriptionsAcademiques() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ semestres() : HasMany</FONT></TD></TR></TABLE>>];
  "annees_universitaires" [label=<<TABLE BORDER="1" COLOR="#B07A12" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF1D6"><TR><TD BGCOLOR="#B07A12"><FONT COLOR="white"><B>AnneeUniversitaire</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ libellé ou code (à confirmer)</FONT></I></TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ date de début (à confirmer)</FONT></I></TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ date de fin (à confirmer)</FONT></I></TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ statut (à confirmer)</FONT></I></TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ promotionsClasses() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ versionsProgrammesPedagogiques() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ inscriptionsAcademiques() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ evaluations() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ sessionsRattrapage() : HasMany</FONT></TD></TR></TABLE>>];
  "promotions" [label=<<TABLE BORDER="1" COLOR="#B07A12" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF1D6"><TR><TD BGCOLOR="#B07A12"><FONT COLOR="white"><B>Promotion</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ etudiant() : HasOne</FONT></TD></TR></TABLE>>];
  "promotions_classes" [label=<<TABLE BORDER="1" COLOR="#B07A12" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF1D6"><TR><TD BGCOLOR="#B07A12"><FONT COLOR="white"><B>PromotionClasse</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ actif : bool</TD></TR><TR><TD ALIGN="LEFT">+ observations : string</TD></TR><TR><TD ALIGN="LEFT">+ created_at : datetime</TD></TR><TR><TD ALIGN="LEFT">+ updated_at : datetime</TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ classe() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ anneeUniversitaire() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ programme() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ promotionClasseUnites() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ affectationsPedagogiques() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ emploisDuTemps() : HasMany</FONT></TD></TR></TABLE>>];
  "programmes" [label=<<TABLE BORDER="1" COLOR="#6B3F86" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EBDDF3"><TR><TD BGCOLOR="#6B3F86"><FONT COLOR="white"><B>Programme</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ code : string</TD></TR><TR><TD ALIGN="LEFT">+ nom : string</TD></TR><TR><TD ALIGN="LEFT">+ description : string</TD></TR><TR><TD ALIGN="LEFT">+ est_actif : bool</TD></TR><TR><TD ALIGN="LEFT">+ created_at : datetime</TD></TR><TR><TD ALIGN="LEFT">+ updated_at : datetime</TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ departement() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ promotionsClasses() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ versionsProgrammesPedagogiques() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ reglesPedagogiques() : HasMany</FONT></TD></TR></TABLE>>];
  "versions_programmes_pedagogiques" [label=<<TABLE BORDER="1" COLOR="#6B3F86" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EBDDF3"><TR><TD BGCOLOR="#6B3F86"><FONT COLOR="white"><B>VersionProgrammePedagogique</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ code : string</TD></TR><TR><TD ALIGN="LEFT">+ libelle : string</TD></TR><TR><TD ALIGN="LEFT">+ version : string</TD></TR><TR><TD ALIGN="LEFT">+ date_debut : date</TD></TR><TR><TD ALIGN="LEFT">+ date_fin : date</TD></TR><TR><TD ALIGN="LEFT">+ statut : string</TD></TR><TR><TD ALIGN="LEFT">+ created_at : datetime</TD></TR><TR><TD ALIGN="LEFT">+ updated_at : datetime</TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ programme() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ anneeUniversitaire() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ versionProgrammeUnites() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ inscriptionsAcademiques() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ reglesPedagogiques() : HasMany</FONT></TD></TR></TABLE>>];
  "version_programme_unites" [label=<<TABLE BORDER="1" COLOR="#6B3F86" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EBDDF3"><TR><TD BGCOLOR="#6B3F86"><FONT COLOR="white"><B>VersionProgrammeUnite</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ versionProgramme() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ uniteEnseignement() : BelongsTo</FONT></TD></TR></TABLE>>];
  "semestres" [label=<<TABLE BORDER="1" COLOR="#B3492F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FCE0D9"><TR><TD BGCOLOR="#B3492F"><FONT COLOR="white"><B>Semestre</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ niveauEtude() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ unitesEnseignement() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ resultatsSemestres() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ emploisDuTemps() : HasMany</FONT></TD></TR></TABLE>>];
  "unites_enseignement" [label=<<TABLE BORDER="1" COLOR="#B3492F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FCE0D9"><TR><TD BGCOLOR="#B3492F"><FONT COLOR="white"><B>UniteEnseignement</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ code (à confirmer)</FONT></I></TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ intitulé (à confirmer)</FONT></I></TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ crédits (à confirmer)</FONT></I></TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ coefficient (à confirmer)</FONT></I></TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ ordre (à confirmer)</FONT></I></TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ caractère obligatoire (à confirmer)</FONT></I></TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ description (à confirmer)</FONT></I></TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ semestre() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ versionProgrammeUnites() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ ecues() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ promotionClasseUnites() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ resultatsUnites() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ derogationsAcademiques() : HasMany</FONT></TD></TR></TABLE>>];
  "ecues" [label=<<TABLE BORDER="1" COLOR="#B3492F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FCE0D9"><TR><TD BGCOLOR="#B3492F"><FONT COLOR="white"><B>Ecue</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ code (à confirmer)</FONT></I></TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ intitulé (à confirmer)</FONT></I></TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ crédits (à confirmer)</FONT></I></TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ coefficient (à confirmer)</FONT></I></TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ seuil éliminatoire (à confirmer)</FONT></I></TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ ordre (à confirmer)</FONT></I></TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ uniteEnseignement() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ evaluations() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ notesRattrapage() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ resultatsEcues() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ derogationsAcademiques() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ affectationsPedagogiques() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#666666">… (+1)</FONT></TD></TR></TABLE>>];
  "promotion_classe_unites" [label=<<TABLE BORDER="1" COLOR="#B3492F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FCE0D9"><TR><TD BGCOLOR="#B3492F"><FONT COLOR="white"><B>PromotionClasseUnite</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ obligatoire : bool</TD></TR><TR><TD ALIGN="LEFT">+ observations : string</TD></TR><TR><TD ALIGN="LEFT">+ created_at : datetime</TD></TR><TR><TD ALIGN="LEFT">+ updated_at : datetime</TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ promotionClasse() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ uniteEnseignement() : BelongsTo</FONT></TD></TR></TABLE>>];
  "regles_pedagogiques" [label=<<TABLE BORDER="1" COLOR="#6B3F86" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EBDDF3"><TR><TD BGCOLOR="#6B3F86"><FONT COLOR="white"><B>ReglePedagogique</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ programme() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ versionProgramme() : BelongsTo</FONT></TD></TR></TABLE>>];
  "affectations_pedagogiques" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>AffectationPedagogique</B>>];
  "cours_plannifies" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>CoursPlannifie</B>>];
  "departements" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>Departement</B>>];
  "derogations_academiques" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>DerogationAcademique</B>>];
  "emplois_du_temps" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>EmploiDuTemps</B>>];
  "etudiants" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>Etudiant</B>>];
  "evaluations" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>Evaluation</B>>];
  "inscriptions_academiques" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>InscriptionAcademique</B>>];
  "notes_rattrapage" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>NoteRattrapage</B>>];
  "resultats_ecues" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>ResultatEcue</B>>];
  "resultats_semestres" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>ResultatSemestre</B>>];
  "resultats_unites" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>ResultatUnite</B>>];
  "sessions_rattrapage" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>SessionRattrapage</B>>];
  "promotions" -> "etudiants" [dir=none, taillabel="0..1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "departements" -> "filieres" [dir=none, taillabel="0..*", headlabel="0..*", labeldistance=1.8, fontsize=9, label="  gerer"];
  "filieres" -> "classes" [dir=none, taillabel="0..*", headlabel="0..*", labeldistance=1.8, fontsize=9, label="  organiser"];
  "niveaux_etude" -> "classes" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "classes" -> "promotions_classes" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "annees_universitaires" -> "promotions_classes" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "programmes" -> "promotions_classes" [dir=none, taillabel="0..1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "departements" -> "programmes" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "programmes" -> "versions_programmes_pedagogiques" [dir=both, arrowtail=odiamond, arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "annees_universitaires" -> "versions_programmes_pedagogiques" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  mid1 [shape=point, width=0.05];
  "versions_programmes_pedagogiques" -> mid1 [dir=none, taillabel="0..*", labeldistance=1.8, fontsize=9];
  mid1 -> "unites_enseignement" [dir=none, headlabel="0..*", labeldistance=1.8, fontsize=9];
  mid1 -> "version_programme_unites" [style=dashed, dir=none];
  "versions_programmes_pedagogiques" -> "inscriptions_academiques" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "annees_universitaires" -> "inscriptions_academiques" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "niveaux_etude" -> "inscriptions_academiques" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "classes" -> "inscriptions_academiques" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "programmes" -> "regles_pedagogiques" [dir=none, taillabel="0..1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "versions_programmes_pedagogiques" -> "regles_pedagogiques" [dir=none, taillabel="0..1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "niveaux_etude" -> "semestres" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "semestres" -> "unites_enseignement" [dir=both, arrowtail=odiamond, arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "unites_enseignement" -> "ecues" [dir=both, arrowtail=odiamond, arrowhead=none, taillabel="0..1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  mid2 [shape=point, width=0.05];
  "promotions_classes" -> mid2 [dir=none, taillabel="0..*", labeldistance=1.8, fontsize=9];

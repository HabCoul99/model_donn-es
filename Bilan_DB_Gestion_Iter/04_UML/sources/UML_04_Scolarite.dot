digraph G {
 graph [rankdir=TB, fontname="DejaVu Sans", fontsize=18, labelloc=t, label=<<B>Diagramme de classes — Scolarité</B>>, pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, ];
 node  [fontname="DejaVu Sans", fontsize=10, shape=plaintext];
 edge  [fontname="DejaVu Sans", fontsize=9, arrowsize=0.7];
  "inscriptions_academiques" [label=<<TABLE BORDER="1" COLOR="#6B3F86" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EBDDF3"><TR><TD BGCOLOR="#6B3F86"><FONT COLOR="white"><B>InscriptionAcademique</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ etudiant() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ anneeUniversitaire() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ niveauEtude() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ classe() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ versionProgramme() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ notes() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#666666">… (+7)</FONT></TD></TR></TABLE>>];
  "derogations_academiques" [label=<<TABLE BORDER="1" COLOR="#1F7F76" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#D9F0EE"><TR><TD BGCOLOR="#1F7F76"><FONT COLOR="white"><B>DerogationAcademique</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ inscriptionAcademique() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ decidePar() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ ecue() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ uniteEnseignement() : BelongsTo</FONT></TD></TR></TABLE>>];
  "decisions_progression" [label=<<TABLE BORDER="1" COLOR="#1F7F76" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#D9F0EE"><TR><TD BGCOLOR="#1F7F76"><FONT COLOR="white"><B>DecisionProgression</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ inscriptionAcademique() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ decidePar() : BelongsTo</FONT></TD></TR></TABLE>>];
  "eligibilites_diplomes" [label=<<TABLE BORDER="1" COLOR="#1F7F76" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#D9F0EE"><TR><TD BGCOLOR="#1F7F76"><FONT COLOR="white"><B>EligibiliteDiplome</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ inscriptionAcademique() : BelongsTo</FONT></TD></TR></TABLE>>];
  "administrateurs" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>Administrateur</B>>];
  "annees_universitaires" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>AnneeUniversitaire</B>>];
  "classes" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>Classe</B>>];
  "ecues" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>Ecue</B>>];
  "etudiants" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>Etudiant</B>>];
  "niveaux_etude" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>NiveauEtude</B>>];
  "notes" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>Note</B>>];
  "notes_rattrapage" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>NoteRattrapage</B>>];
  "resultats_ecues" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>ResultatEcue</B>>];
  "resultats_semestres" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>ResultatSemestre</B>>];
  "resultats_unites" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>ResultatUnite</B>>];
  "unites_enseignement" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>UniteEnseignement</B>>];
  "versions_programmes_pedagogiques" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>VersionProgrammePedagogique</B>>];
  "etudiants" -> "inscriptions_academiques" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "versions_programmes_pedagogiques" -> "inscriptions_academiques" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];

  "inscriptions_academiques" -> "notes" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "inscriptions_academiques" -> "notes_rattrapage" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "inscriptions_academiques" -> "resultats_ecues" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "inscriptions_academiques" -> "resultats_unites" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "inscriptions_academiques" -> "resultats_semestres" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "inscriptions_academiques" -> "decisions_progression" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "administrateurs" -> "decisions_progression" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9, label="decidePar"];
  "inscriptions_academiques" -> "eligibilites_diplomes" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "inscriptions_academiques" -> "derogations_academiques" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "administrateurs" -> "derogations_academiques" [dir=none, taillabel="0..1", headlabel="0..*", labeldistance=1.8, fontsize=9, label="decidePar"];
  "ecues" -> "derogations_academiques" [dir=none, taillabel="0..1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "unites_enseignement" -> "derogations_academiques" [dir=none, taillabel="0..1", headlabel="0..*", labeldistance=1.8, fontsize=9];

digraph G {
 graph [rankdir=TB, fontname="DejaVu Sans", fontsize=18, labelloc=t, label=<<B>Diagramme de classes — Sécurité et plateforme</B>>, pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, ];
 node  [fontname="DejaVu Sans", fontsize=10, shape=plaintext];
 edge  [fontname="DejaVu Sans", fontsize=9, arrowsize=0.7];
  "users" [label=<<TABLE BORDER="1" COLOR="#3F7D2E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E3F2DD"><TR><TD BGCOLOR="#3F7D2E"><FONT COLOR="white"><B>User</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ name : string</TD></TR><TR><TD ALIGN="LEFT">+ email : string</TD></TR><TR><TD ALIGN="LEFT">+ password : string</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ administrateur() : BelongsTo</FONT></TD></TR></TABLE>>];
  "roles" [label=<<TABLE BORDER="1" COLOR="#555555" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E8E8E8"><TR><TD BGCOLOR="#555555"><FONT COLOR="white"><B>Role</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
  "permissions" [label=<<TABLE BORDER="1" COLOR="#555555" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E8E8E8"><TR><TD BGCOLOR="#555555"><FONT COLOR="white"><B>Permission</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
  "modules_plateforme" [label=<<TABLE BORDER="1" COLOR="#555555" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E8E8E8"><TR><TD BGCOLOR="#555555"><FONT COLOR="white"><B>ModulePlateforme</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ structureModules() : HasMany</FONT></TD></TR></TABLE>>];
  "structure_modules" [label=<<TABLE BORDER="1" COLOR="#555555" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E8E8E8"><TR><TD BGCOLOR="#555555"><FONT COLOR="white"><B>StructureModule</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ structure() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ modulePlateforme() : BelongsTo</FONT></TD></TR></TABLE>>];
  "structures" [label=<<TABLE BORDER="1" COLOR="#2F5D8C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DCE9F7"><TR><TD BGCOLOR="#2F5D8C"><FONT COLOR="white"><B>Structure</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ code : string</TD></TR><TR><TD ALIGN="LEFT">+ nom : string</TD></TR><TR><TD ALIGN="LEFT">+ description : string</TD></TR><TR><TD ALIGN="LEFT">+ actif : bool</TD></TR><TR><TD ALIGN="LEFT">+ archivee : bool</TD></TR><TR><TD ALIGN="LEFT">+ created_at : datetime</TD></TR><TR><TD ALIGN="LEFT">+ updated_at : datetime</TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ typeStructure() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ parent() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ enfants() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ departements() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ postesStructures() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ structureModules() : HasMany</FONT></TD></TR></TABLE>>];
  "administrateurs" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>Administrateur</B>>];
  "departements" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>Departement</B>>];
  "postes_structures" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>PosteStructure</B>>];
  "types_structures" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>TypeStructure</B>>];
  "types_structures" -> "structures" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "structures" -> "structures" [dir=both, arrowtail=odiamond, arrowhead=none, taillabel="0..1", headlabel="0..*", labeldistance=1.8, fontsize=9, label="parent"];
  "structures" -> "departements" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "structures" -> "postes_structures" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "administrateurs" -> "users" [dir=none, taillabel="1", headlabel="0..1", labeldistance=1.8, fontsize=9];
  "users" -> "roles" [dir=none, taillabel="0..*", headlabel="0..*", labeldistance=1.8, fontsize=9, label="  avoir role"];
  "roles" -> "permissions" [dir=none, taillabel="0..*", headlabel="0..*", labeldistance=1.8, fontsize=9, label="  accorder"];
  mid1 [shape=point, width=0.05];
  "structures" -> mid1 [dir=none, taillabel="0..*", labeldistance=1.8, fontsize=9];
  mid1 -> "modules_plateforme" [dir=none, headlabel="0..*", labeldistance=1.8, fontsize=9];
  mid1 -> "structure_modules" [style=dashed, dir=none];
}

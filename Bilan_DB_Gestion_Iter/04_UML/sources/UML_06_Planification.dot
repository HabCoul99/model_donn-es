digraph G {
 graph [rankdir=TB, fontname="DejaVu Sans", fontsize=18, labelloc=t, label=<<B>Diagramme de classes — Planification</B>>, pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, ];
 node  [fontname="DejaVu Sans", fontsize=10, shape=plaintext];
 edge  [fontname="DejaVu Sans", fontsize=9, arrowsize=0.7];
  "affectations_pedagogiques" [label=<<TABLE BORDER="1" COLOR="#B03A66" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFE9F0"><TR><TD BGCOLOR="#B03A66"><FONT COLOR="white"><B>AffectationPedagogique</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ date_debut : date</TD></TR><TR><TD ALIGN="LEFT">+ date_fin : date</TD></TR><TR><TD ALIGN="LEFT">+ statut : string</TD></TR><TR><TD ALIGN="LEFT">+ observations : string</TD></TR><TR><TD ALIGN="LEFT">+ created_at : datetime</TD></TR><TR><TD ALIGN="LEFT">+ updated_at : datetime</TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ promotionClasse() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ ecue() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ professeur() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ coursPlannifies() : HasMany</FONT></TD></TR></TABLE>>];
  "emplois_du_temps" [label=<<TABLE BORDER="1" COLOR="#B03A66" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFE9F0"><TR><TD BGCOLOR="#B03A66"><FONT COLOR="white"><B>EmploiDuTemps</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ date_debut : date</TD></TR><TR><TD ALIGN="LEFT">+ date_fin : date</TD></TR><TR><TD ALIGN="LEFT">+ statut : string</TD></TR><TR><TD ALIGN="LEFT">+ description : string</TD></TR><TR><TD ALIGN="LEFT">+ created_at : datetime</TD></TR><TR><TD ALIGN="LEFT">+ updated_at : datetime</TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ promotionClasse() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ semestre() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ coursPlannifies() : HasMany</FONT></TD></TR></TABLE>>];
  "cours_plannifies" [label=<<TABLE BORDER="1" COLOR="#B03A66" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFE9F0"><TR><TD BGCOLOR="#B03A66"><FONT COLOR="white"><B>CoursPlannifie</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ jour_semaine : string</TD></TR><TR><TD ALIGN="LEFT">+ creneau : string</TD></TR><TR><TD ALIGN="LEFT">+ date_debut : date</TD></TR><TR><TD ALIGN="LEFT">+ date_fin : date</TD></TR><TR><TD ALIGN="LEFT">+ statut : string</TD></TR><TR><TD ALIGN="LEFT">+ observations : string</TD></TR><TR><TD ALIGN="LEFT">+ created_at : datetime</TD></TR><TR><TD ALIGN="LEFT">+ updated_at : datetime</TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ emploiDuTemps() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ ecue() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ professeur() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ salle() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ affectationPedagogique() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ historiqueCoursPlannifies() : HasMany</FONT></TD></TR></TABLE>>];
  "historique_cours_plannifies" [label=<<TABLE BORDER="1" COLOR="#B03A66" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFE9F0"><TR><TD BGCOLOR="#B03A66"><FONT COLOR="white"><B>HistoriqueCoursPlannifie</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ coursPlannifie() : BelongsTo</FONT></TD></TR></TABLE>>];
  "salles" [label=<<TABLE BORDER="1" COLOR="#B03A66" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFE9F0"><TR><TD BGCOLOR="#B03A66"><FONT COLOR="white"><B>Salle</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ code : string</TD></TR><TR><TD ALIGN="LEFT">+ nom : string</TD></TR><TR><TD ALIGN="LEFT">+ type : string</TD></TR><TR><TD ALIGN="LEFT">+ capacite : int</TD></TR><TR><TD ALIGN="LEFT">+ localisation : string</TD></TR><TR><TD ALIGN="LEFT">+ statut : string</TD></TR><TR><TD ALIGN="LEFT">+ description : string</TD></TR><TR><TD ALIGN="LEFT">+ created_at : datetime</TD></TR><TR><TD ALIGN="LEFT">+ updated_at : datetime</TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ coursPlannifies() : HasMany</FONT></TD></TR></TABLE>>];
  "evenements" [label=<<TABLE BORDER="1" COLOR="#B03A66" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFE9F0"><TR><TD BGCOLOR="#B03A66"><FONT COLOR="white"><B>Evenement</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
  "ecues" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>Ecue</B>>];
  "professeurs" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>Professeur</B>>];
  "promotions_classes" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>PromotionClasse</B>>];
  "semestres" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>Semestre</B>>];
  "professeurs" -> "affectations_pedagogiques" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "promotions_classes" -> "affectations_pedagogiques" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "ecues" -> "affectations_pedagogiques" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "promotions_classes" -> "emplois_du_temps" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "semestres" -> "emplois_du_temps" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "emplois_du_temps" -> "cours_plannifies" [dir=both, arrowtail=odiamond, arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "professeurs" -> "cours_plannifies" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "salles" -> "cours_plannifies" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "ecues" -> "cours_plannifies" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "affectations_pedagogiques" -> "cours_plannifies" [dir=none, taillabel="0..1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "historique_cours_plannifies" -> "cours_plannifies" [style=dashed, arrowhead=vee, label="«trace»", fontsize=9];
}

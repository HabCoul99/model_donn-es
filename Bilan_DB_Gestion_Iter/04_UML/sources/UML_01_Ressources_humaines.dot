digraph G {
 graph [rankdir=TB, fontname="DejaVu Sans", fontsize=18, labelloc=t, label=<<B>Diagramme de classes — Ressources humaines</B>>, pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, ];
 node  [fontname="DejaVu Sans", fontsize=10, shape=plaintext];
 edge  [fontname="DejaVu Sans", fontsize=9, arrowsize=0.7];
  "personnes" [label=<<TABLE BORDER="1" COLOR="#3F7D2E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E3F2DD"><TR><TD BGCOLOR="#3F7D2E"><FONT COLOR="white"><B>Personne</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ nom : string</TD></TR><TR><TD ALIGN="LEFT">+ prenoms : string</TD></TR><TR><TD ALIGN="LEFT">+ sexe : string</TD></TR><TR><TD ALIGN="LEFT">+ date_naissance : date</TD></TR><TR><TD ALIGN="LEFT">+ lieu_naissance : string</TD></TR><TR><TD ALIGN="LEFT">+ nationalite : string</TD></TR><TR><TD ALIGN="LEFT">+ telephone : string</TD></TR><TR><TD ALIGN="LEFT">+ email : string</TD></TR><TR><TD ALIGN="LEFT">+ adresse : string</TD></TR><TR><TD ALIGN="LEFT">+ photo : string</TD></TR><TR><TD ALIGN="LEFT">+ created_at : datetime</TD></TR><TR><TD ALIGN="LEFT">+ updated_at : datetime</TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ affectationsPostes() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ etudiant() : HasOne</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ professeur() : HasOne</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ administrateur() : HasOne</FONT></TD></TR></TABLE>>];
  "etudiants" [label=<<TABLE BORDER="1" COLOR="#3F7D2E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E3F2DD"><TR><TD BGCOLOR="#3F7D2E"><FONT COLOR="white"><B>Etudiant</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ matricule : string</TD></TR><TR><TD ALIGN="LEFT">+ date_premiere_inscription : date</TD></TR><TR><TD ALIGN="LEFT">+ statut : string</TD></TR><TR><TD ALIGN="LEFT">+ observations : string</TD></TR><TR><TD ALIGN="LEFT">+ created_at : datetime</TD></TR><TR><TD ALIGN="LEFT">+ updated_at : datetime</TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ personne() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ promotion() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ inscriptionsAcademiques() : HasMany</FONT></TD></TR></TABLE>>];
  "professeurs" [label=<<TABLE BORDER="1" COLOR="#3F7D2E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E3F2DD"><TR><TD BGCOLOR="#3F7D2E"><FONT COLOR="white"><B>Professeur</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ matricule : string</TD></TR><TR><TD ALIGN="LEFT">+ grade : string</TD></TR><TR><TD ALIGN="LEFT">+ specialite : string</TD></TR><TR><TD ALIGN="LEFT">+ date_recrutement : date</TD></TR><TR><TD ALIGN="LEFT">+ statut : string</TD></TR><TR><TD ALIGN="LEFT">+ observations : string</TD></TR><TR><TD ALIGN="LEFT">+ created_at : datetime</TD></TR><TR><TD ALIGN="LEFT">+ updated_at : datetime</TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ personne() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ affectationsPedagogiques() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ coursPlannifies() : HasMany</FONT></TD></TR></TABLE>>];
  "administrateurs" [label=<<TABLE BORDER="1" COLOR="#3F7D2E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E3F2DD"><TR><TD BGCOLOR="#3F7D2E"><FONT COLOR="white"><B>Administrateur</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ matricule : string</TD></TR><TR><TD ALIGN="LEFT">+ fonction : string</TD></TR><TR><TD ALIGN="LEFT">+ statut : string</TD></TR><TR><TD ALIGN="LEFT">+ created_at : datetime</TD></TR><TR><TD ALIGN="LEFT">+ updated_at : datetime</TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ personne() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ user() : HasOne</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ notes() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ notesRattrapage() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ decisionsProgression() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ derogationsAcademiques() : HasMany</FONT></TD></TR></TABLE>>];
  "users" [label=<<TABLE BORDER="1" COLOR="#3F7D2E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E3F2DD"><TR><TD BGCOLOR="#3F7D2E"><FONT COLOR="white"><B>User</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ name : string</TD></TR><TR><TD ALIGN="LEFT">+ email : string</TD></TR><TR><TD ALIGN="LEFT">+ password : string</TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">+ … (attributs à confirmer)</FONT></I></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ administrateur() : BelongsTo</FONT></TD></TR></TABLE>>];
  "affectations_pedagogiques" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>AffectationPedagogique</B>>];
  "affectations_postes" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>AffectationPoste</B>>];
  "cours_plannifies" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>CoursPlannifie</B>>];
  "decisions_progression" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>DecisionProgression</B>>];
  "derogations_academiques" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>DerogationAcademique</B>>];
  "inscriptions_academiques" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>InscriptionAcademique</B>>];
  "notes" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>Note</B>>];
  "notes_rattrapage" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>NoteRattrapage</B>>];
  "promotions" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>Promotion</B>>];
  "roles" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>Role</B>>];
  "personnes" -> "affectations_postes" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "personnes" -> "etudiants" [dir=none, taillabel="1", headlabel="0..1", labeldistance=1.8, fontsize=9];
  "personnes" -> "professeurs" [dir=none, taillabel="1", headlabel="0..1", labeldistance=1.8, fontsize=9];
  "personnes" -> "administrateurs" [dir=none, taillabel="1", headlabel="0..1", labeldistance=1.8, fontsize=9];
  "administrateurs" -> "users" [dir=none, taillabel="1", headlabel="0..1", labeldistance=1.8, fontsize=9];
  "promotions" -> "etudiants" [dir=none, taillabel="0..1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "etudiants" -> "inscriptions_academiques" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "administrateurs" -> "notes" [dir=none, taillabel="0..1", headlabel="0..*", labeldistance=1.8, fontsize=9, label="saisiePar"];
  "administrateurs" -> "notes_rattrapage" [dir=none, taillabel="0..1", headlabel="0..*", labeldistance=1.8, fontsize=9, label="saisiePar"];
  "administrateurs" -> "decisions_progression" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9, label="decidePar"];
  "administrateurs" -> "derogations_academiques" [dir=none, taillabel="0..1", headlabel="0..*", labeldistance=1.8, fontsize=9, label="decidePar"];
  "professeurs" -> "affectations_pedagogiques" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "professeurs" -> "cours_plannifies" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "users" -> "roles" [dir=none, taillabel="0..*", headlabel="0..*", labeldistance=1.8, fontsize=9, label="  avoir role"];
}

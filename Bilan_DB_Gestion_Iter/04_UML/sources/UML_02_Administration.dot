digraph G {
 graph [rankdir=TB, fontname="DejaVu Sans", fontsize=18, labelloc=t, label=<<B>Diagramme de classes — Administration</B>>, pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, ];
 node  [fontname="DejaVu Sans", fontsize=10, shape=plaintext];
 edge  [fontname="DejaVu Sans", fontsize=9, arrowsize=0.7];
  "types_structures" [label=<<TABLE BORDER="1" COLOR="#2F5D8C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DCE9F7"><TR><TD BGCOLOR="#2F5D8C"><FONT COLOR="white"><B>TypeStructure</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ code : string</TD></TR><TR><TD ALIGN="LEFT">+ libelle : string</TD></TR><TR><TD ALIGN="LEFT">+ description : string</TD></TR><TR><TD ALIGN="LEFT">+ actif : bool</TD></TR><TR><TD ALIGN="LEFT">+ created_at : datetime</TD></TR><TR><TD ALIGN="LEFT">+ updated_at : datetime</TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ structures() : HasMany</FONT></TD></TR></TABLE>>];
  "structures" [label=<<TABLE BORDER="1" COLOR="#2F5D8C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DCE9F7"><TR><TD BGCOLOR="#2F5D8C"><FONT COLOR="white"><B>Structure</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ code : string</TD></TR><TR><TD ALIGN="LEFT">+ nom : string</TD></TR><TR><TD ALIGN="LEFT">+ description : string</TD></TR><TR><TD ALIGN="LEFT">+ actif : bool</TD></TR><TR><TD ALIGN="LEFT">+ archivee : bool</TD></TR><TR><TD ALIGN="LEFT">+ created_at : datetime</TD></TR><TR><TD ALIGN="LEFT">+ updated_at : datetime</TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ typeStructure() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ parent() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ enfants() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ departements() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ postesStructures() : HasMany</FONT></TD></TR></TABLE>>];
  "departements" [label=<<TABLE BORDER="1" COLOR="#2F5D8C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DCE9F7"><TR><TD BGCOLOR="#2F5D8C"><FONT COLOR="white"><B>Departement</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ code : string</TD></TR><TR><TD ALIGN="LEFT">+ nom : string</TD></TR><TR><TD ALIGN="LEFT">+ description : string</TD></TR><TR><TD ALIGN="LEFT">+ est_actif : bool</TD></TR><TR><TD ALIGN="LEFT">+ created_at : datetime</TD></TR><TR><TD ALIGN="LEFT">+ updated_at : datetime</TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ structure() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ filieres() : HasMany</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ programmes() : HasMany</FONT></TD></TR></TABLE>>];
  "postes" [label=<<TABLE BORDER="1" COLOR="#2F5D8C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DCE9F7"><TR><TD BGCOLOR="#2F5D8C"><FONT COLOR="white"><B>Poste</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ code : string</TD></TR><TR><TD ALIGN="LEFT">+ libelle : string</TD></TR><TR><TD ALIGN="LEFT">+ description : string</TD></TR><TR><TD ALIGN="LEFT">+ actif : bool</TD></TR><TR><TD ALIGN="LEFT">+ created_at : datetime</TD></TR><TR><TD ALIGN="LEFT">+ updated_at : datetime</TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ postesStructures() : HasMany</FONT></TD></TR></TABLE>>];
  "postes_structures" [label=<<TABLE BORDER="1" COLOR="#2F5D8C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DCE9F7"><TR><TD BGCOLOR="#2F5D8C"><FONT COLOR="white"><B>PosteStructure</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ description : string</TD></TR><TR><TD ALIGN="LEFT">+ actif : bool</TD></TR><TR><TD ALIGN="LEFT">+ created_at : datetime</TD></TR><TR><TD ALIGN="LEFT">+ updated_at : datetime</TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ structure() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ poste() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ affectationsPostes() : HasMany</FONT></TD></TR></TABLE>>];
  "affectations_postes" [label=<<TABLE BORDER="1" COLOR="#2F5D8C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DCE9F7"><TR><TD BGCOLOR="#2F5D8C"><FONT COLOR="white"><B>AffectationPoste</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ date_debut : date</TD></TR><TR><TD ALIGN="LEFT">+ date_fin : date</TD></TR><TR><TD ALIGN="LEFT">+ motif : string</TD></TR><TR><TD ALIGN="LEFT">+ created_at : datetime</TD></TR><TR><TD ALIGN="LEFT">+ updated_at : datetime</TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ posteStructure() : BelongsTo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ personne() : BelongsTo</FONT></TD></TR></TABLE>>];
  "filieres" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>Filiere</B>>];
  "modules_plateforme" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>ModulePlateforme</B>>];
  "personnes" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>Personne</B>>];
  "programmes" [shape=box, style="filled", fillcolor="#F2F2F2", color="#999999", fontsize=10, label=<<B>Programme</B>>];
  "types_structures" -> "structures" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "structures" -> "structures" [dir=both, arrowtail=odiamond, arrowhead=none, taillabel="0..1", headlabel="0..*", labeldistance=1.8, fontsize=9, label="parent"];
  "structures" -> "departements" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "structures" -> "postes_structures" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "postes" -> "postes_structures" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "postes_structures" -> "affectations_postes" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "personnes" -> "affectations_postes" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "departements" -> "filieres" [dir=none, taillabel="0..*", headlabel="0..*", labeldistance=1.8, fontsize=9, label="  gerer"];
  "departements" -> "programmes" [dir=none, taillabel="1", headlabel="0..*", labeldistance=1.8, fontsize=9];
  "structures" -> "modules_plateforme" [dir=none, taillabel="0..*", headlabel="0..*", labeldistance=1.8, fontsize=9];
}

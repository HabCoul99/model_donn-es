digraph G {
 graph [rankdir=TB, fontname="DejaVu Sans", fontsize=18, labelloc=t, label=<<B>MCD 03 — Structure pédagogique</B>>, pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, ];
 node  [fontname="DejaVu Sans", fontsize=10, shape=plaintext];
 edge  [fontname="DejaVu Sans", fontsize=9, arrowsize=0.7];
  "filieres" [shape=plaintext, label=<<TABLE BORDER="1" COLOR="#B07A12" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF1D6"><TR><TD BGCOLOR="#B07A12"><FONT COLOR="white"><B>FILIERE</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><HR/><TR><TD ALIGN="LEFT">code</TD></TR><TR><TD ALIGN="LEFT">nom</TD></TR><TR><TD ALIGN="LEFT">description</TD></TR><TR><TD ALIGN="LEFT">actif</TD></TR></TABLE>>];
  "classes" [shape=plaintext, label=<<TABLE BORDER="1" COLOR="#B07A12" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF1D6"><TR><TD BGCOLOR="#B07A12"><FONT COLOR="white"><B>CLASSE</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><HR/><TR><TD ALIGN="LEFT">code</TD></TR><TR><TD ALIGN="LEFT">nom</TD></TR><TR><TD ALIGN="LEFT">description</TD></TR><TR><TD ALIGN="LEFT">capacite</TD></TR><TR><TD ALIGN="LEFT">actif</TD></TR></TABLE>>];
  "niveaux_etude" [shape=plaintext, label=<<TABLE BORDER="1" COLOR="#B07A12" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF1D6"><TR><TD BGCOLOR="#B07A12"><FONT COLOR="white"><B>NIVEAU_ETUDE</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><HR/><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">… autres propriétés à confirmer</FONT></I></TD></TR></TABLE>>];
  "annees_universitaires" [shape=plaintext, label=<<TABLE BORDER="1" COLOR="#B07A12" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF1D6"><TR><TD BGCOLOR="#B07A12"><FONT COLOR="white"><B>ANNEE_UNIVERSITAIRE</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><HR/><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">libellé ou code (?)</FONT></I></TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">date de début (?)</FONT></I></TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">date de fin (?)</FONT></I></TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">statut (?)</FONT></I></TD></TR><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">… autres propriétés à confirmer</FONT></I></TD></TR></TABLE>>];
  "promotions" [shape=plaintext, label=<<TABLE BORDER="1" COLOR="#B07A12" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF1D6"><TR><TD BGCOLOR="#B07A12"><FONT COLOR="white"><B>PROMOTION</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><HR/><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">… autres propriétés à confirmer</FONT></I></TD></TR></TABLE>>];
  "promotions_classes" [shape=plaintext, label=<<TABLE BORDER="1" COLOR="#B07A12" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF1D6"><TR><TD BGCOLOR="#B07A12"><FONT COLOR="white"><B>PROMOTION_CLASSE</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><HR/><TR><TD ALIGN="LEFT">actif</TD></TR><TR><TD ALIGN="LEFT">observations</TD></TR></TABLE>>];
  "departements" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", fontsize=11, label=<<B>DEPARTEMENT</B>>];
  "programmes" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", fontsize=11, label=<<B>PROGRAMME</B>>];
  as0 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD><B>GERER</B></TD></TR></TABLE>>];
  "departements" -> as0 [dir=none, taillabel="0,N", labeldistance=1.8, labelangle=20, fontsize=10];
  as0 -> "filieres" [dir=none, headlabel="0,N", labeldistance=1.8, labelangle=20, fontsize=10];
  as1 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD><B>ORGANISER</B></TD></TR></TABLE>>];
  "filieres" -> as1 [dir=none, taillabel="0,N", labeldistance=1.8, labelangle=20, fontsize=10];
  as1 -> "classes" [dir=none, headlabel="0,N", labeldistance=1.8, labelangle=20, fontsize=10];
  as2 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD><B>CLASSER_NIVEAU</B></TD></TR></TABLE>>];
  "niveaux_etude" -> as2 [dir=none, taillabel="0,N", labeldistance=1.8, labelangle=20, fontsize=10];
  as2 -> "classes" [dir=none, headlabel="1,1", labeldistance=1.8, labelangle=20, fontsize=10];
  as3 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD><B>DECLINER</B></TD></TR></TABLE>>];
  "classes" -> as3 [dir=none, taillabel="0,N", labeldistance=1.8, labelangle=20, fontsize=10];
  as3 -> "promotions_classes" [dir=none, headlabel="1,1", labeldistance=1.8, labelangle=20, fontsize=10];
  as4 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD><B>PLANIFIER_ANNEE</B></TD></TR></TABLE>>];
  "annees_universitaires" -> as4 [dir=none, taillabel="0,N", labeldistance=1.8, labelangle=20, fontsize=10];
  as4 -> "promotions_classes" [dir=none, headlabel="1,1", labeldistance=1.8, labelangle=20, fontsize=10];
  as5 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD><B>SUIVRE_PROGRAMME</B></TD></TR></TABLE>>];
  "programmes" -> as5 [dir=none, taillabel="0,N", labeldistance=1.8, labelangle=20, fontsize=10];
  as5 -> "promotions_classes" [dir=none, headlabel="0,1", labeldistance=1.8, labelangle=20, fontsize=10];
}

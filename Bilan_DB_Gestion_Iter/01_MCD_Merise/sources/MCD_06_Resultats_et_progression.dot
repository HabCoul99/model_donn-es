digraph G {
 graph [rankdir=TB, fontname="DejaVu Sans", fontsize=18, labelloc=t, label=<<B>MCD 06 — Résultats et progression</B>>, pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, ];

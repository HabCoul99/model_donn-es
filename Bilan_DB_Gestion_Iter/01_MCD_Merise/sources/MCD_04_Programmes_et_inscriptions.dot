digraph G {
 graph [rankdir=TB, fontname="DejaVu Sans", fontsize=18, labelloc=t, label=<<B>MCD 04 — Programmes et inscriptions</B>>, pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, ];
 node  [fontname="DejaVu Sans", fontsize=10, shape=plaintext];
 edge  [fontname="DejaVu Sans", fontsize=9, arrowsize=0.7];
  "programmes" [shape=plaintext, label=<<TABLE BORDER="1" COLOR="#6B3F86" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EBDDF3"><TR><TD BGCOLOR="#6B3F86"><FONT COLOR="white"><B>PROGRAMME</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><HR/><TR><TD ALIGN="LEFT">code</TD></TR><TR><TD ALIGN="LEFT">nom</TD></TR><TR><TD ALIGN="LEFT">description</TD></TR><TR><TD ALIGN="LEFT">est_actif</TD></TR></TABLE>>];
  "versions_programmes_pedagogiques" [shape=plaintext, label=<<TABLE BORDER="1" COLOR="#6B3F86" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EBDDF3"><TR><TD BGCOLOR="#6B3F86"><FONT COLOR="white"><B>VERSION_PROGRAMME_PEDAGOGIQUE</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><HR/><TR><TD ALIGN="LEFT">code</TD></TR><TR><TD ALIGN="LEFT">libelle</TD></TR><TR><TD ALIGN="LEFT">version</TD></TR><TR><TD ALIGN="LEFT">date_debut</TD></TR><TR><TD ALIGN="LEFT">date_fin</TD></TR><TR><TD ALIGN="LEFT">statut</TD></TR></TABLE>>];
  "inscriptions_academiques" [shape=plaintext, label=<<TABLE BORDER="1" COLOR="#6B3F86" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EBDDF3"><TR><TD BGCOLOR="#6B3F86"><FONT COLOR="white"><B>INSCRIPTION_ACADEMIQUE</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><HR/><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">… autres propriétés à confirmer</FONT></I></TD></TR></TABLE>>];
  "regles_pedagogiques" [shape=plaintext, label=<<TABLE BORDER="1" COLOR="#6B3F86" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EBDDF3"><TR><TD BGCOLOR="#6B3F86"><FONT COLOR="white"><B>REGLE_PEDAGOGIQUE</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><HR/><TR><TD ALIGN="LEFT"><I><FONT COLOR="#666666">… autres propriétés à confirmer</FONT></I></TD></TR></TABLE>>];
  "annees_universitaires" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", fontsize=11, label=<<B>ANNEE_UNIVERSITAIRE</B>>];
  "classes" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", fontsize=11, label=<<B>CLASSE</B>>];
  "departements" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", fontsize=11, label=<<B>DEPARTEMENT</B>>];
  "etudiants" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", fontsize=11, label=<<B>ETUDIANT</B>>];
  "niveaux_etude" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", fontsize=11, label=<<B>NIVEAU_ETUDE</B>>];
  "unites_enseignement" [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#999999", fontsize=11, label=<<B>UNITE_ENSEIGNEMENT</B>>];
  as0 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD><B>PROPOSER</B></TD></TR></TABLE>>];
  "departements" -> as0 [dir=none, taillabel="0,N", labeldistance=1.8, labelangle=20, fontsize=10];
  as0 -> "programmes" [dir=none, headlabel="1,1", labeldistance=1.8, labelangle=20, fontsize=10];
  as1 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD><B>VERSIONNER</B></TD></TR></TABLE>>];
  "programmes" -> as1 [dir=none, taillabel="0,N", labeldistance=1.8, labelangle=20, fontsize=10];

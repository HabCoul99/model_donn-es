  as3 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD><B>COMPOSER_VERSION</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">… (à confirmer)</FONT></TD></TR></TABLE>>];
  "versions_programmes_pedagogiques" -> as3 [dir=none, taillabel="0,N", labeldistance=1.8, labelangle=20, fontsize=10];
  as3 -> "unites_enseignement" [dir=none, headlabel="0,N", labeldistance=1.8, labelangle=20, fontsize=10];
  as4 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD><B>S_INSCRIRE</B></TD></TR></TABLE>>];
  "etudiants" -> as4 [dir=none, taillabel="0,N", labeldistance=1.8, labelangle=20, fontsize=10];
  as4 -> "inscriptions_academiques" [dir=none, headlabel="1,1", labeldistance=1.8, labelangle=20, fontsize=10];

  "annees_universitaires" -> as6 [dir=none, taillabel="0,N", labeldistance=1.8, labelangle=20, fontsize=10];
  as6 -> "inscriptions_academiques" [dir=none, headlabel="1,1", labeldistance=1.8, labelangle=20, fontsize=10];
  as7 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD><B>INSCRIRE_NIVEAU</B></TD></TR></TABLE>>];

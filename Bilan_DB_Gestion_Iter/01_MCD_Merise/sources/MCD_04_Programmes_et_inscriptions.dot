  as10 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD><B>ENCADRER_VERSION</B></TD></TR></TABLE>>];
  "versions_programmes_pedagogiques" -> as10 [dir=none, taillabel="0,N", labeldistance=1.8, labelangle=20, fontsize=10];

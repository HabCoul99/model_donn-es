  as8 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD><B>INSCRIRE_CLASSE</B></TD></TR></TABLE>>];
  "classes" -> as8 [dir=none, taillabel="0,N", labeldistance=1.8, labelangle=20, fontsize=10];
  as8 -> "inscriptions_academiques" [dir=none, headlabel="1,1", labeldistance=1.8, labelangle=20, fontsize=10];
  as9 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="white"><TR><TD><B>ENCADRER_PROGRAMME</B></TD></TR></TABLE>>];
  "programmes" -> as9 [dir=none, taillabel="0,N", labeldistance=1.8, labelangle=20, fontsize=10];
